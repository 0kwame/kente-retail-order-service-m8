<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.kenteretail</groupId>
  <artifactId>order-service</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>order-service</name>
  <description>Kente Retail order-service -- Phase-1 fallback starter for the CI/CD module ("No More 2 A.M. Releases").</description>

  <properties>
    <java.version>17</java.version>

<!-- Spring Boot 3.2.5 manages Tomcat 10.1.20, which carries four
         CRITICAL CVEs that all have fixes available: CVE-2025-24813,
         CVE-2026-41293, CVE-2026-43512, CVE-2026-43515. The pipeline's Trivy
         gate found them on its first run against this repo, which is the gate
         doing exactly what it was added to do.

         Overriding tomcat.version is Spring Boot's own documented mechanism for
         patching a managed dependency. Its blast radius is a Tomcat patch
         release rather than a whole framework bump, which is the right trade the
         week before Kente Fest. Remove this override at the next Spring Boot
         upgrade rather than carrying it forward. -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>order-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
