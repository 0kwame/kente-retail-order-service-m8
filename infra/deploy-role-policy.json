{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppConfigBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::kente-retail-order-service-config",
        "arn:aws:s3:::kente-retail-order-service-config/*"
      ]
    },
    {
      "Sid": "WriteOrderTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/kente-retail-orders"
    },
    {
      "Sid": "ShipLogsAndMetrics",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}
